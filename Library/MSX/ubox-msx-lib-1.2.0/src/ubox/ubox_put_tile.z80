.globl _ubox_put_tile

WRTVRM = 0x004d
BG_TILE_MAP = 0x1800

_ubox_put_tile::
	ld c, a
	ld b, l

	ld hl, #2
	add hl, sp
	ld a, (hl)

	ld h, #0
	ld l, b
	add hl, hl
	add hl, hl
	add hl, hl
	add hl, hl
	add hl, hl
	ld b, #0
	add hl, bc

	ld bc, #BG_TILE_MAP
	add hl, bc

	call WRTVRM

	pop hl
	inc sp
	jp (hl)
